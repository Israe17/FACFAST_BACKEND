PORT=3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:123456@localhost:5432/facfast_db

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_NAME=facfast_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false
DB_USE_PG_MEM=false

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_COOKIE_NAME=ff_access_token
REFRESH_COOKIE_NAME=ff_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Set AUTH_COOKIE_SAME_SITE=none when the frontend and backend live on
# different sites (e.g. app.example.com → api.other-domain.com). Required
# for the browser to send the auth cookie on cross-site requests and on
# the WebSocket upgrade. The `none` value is only valid in combination
# with AUTH_COOKIE_SECURE=true and an HTTPS deployment — the app refuses
# to boot if you mix `none` with `secure=false`. Default `lax` is fine
# for same-site deployments (subdomains under one registrable domain).

# Optional. Point this at a shared Redis when the backend runs behind a
# load balancer with more than one Node process: Socket.io rooms only
# span across instances when an adapter forwards events between them.
# Leave empty (or unset) for single-instance dev / staging — the in-
# memory adapter takes over automatically.
# REDIS_URL=redis://localhost:6379

FIELD_ENCRYPTION_KEY=replace-with-strong-field-encryption-key
